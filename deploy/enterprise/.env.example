# Copy to .env (git-ignored, mode 0600) and fill the three values that say replace-with. Compose reads .env for the variables
# below; the engine's other settings are in compose.yaml. Never commit the populated file.

# Registry prefix for the image this project builds; empty keeps a local-only name. Nothing is pushed.
IMAGE_REGISTRY=

# ---- who this engine is at the payment clearinghouse ----------------------------------------------
# What the clearinghouse admin handed over at onboarding: the tenant admin key and the tenant's id.
LPB_CLEARINGHOUSE_TOKEN=replace-with-the-tenant-admin-key
LPB_CLEARINGHOUSE_TENANT_ID=replace-with-the-tenant-id
# The clearinghouse's public listener. On one host it is the clearinghouse project's engine, on the
# edge network the two projects share.
LPB_CLEARINGHOUSE_URL=http://clearinghouse:8080
# The signer the clearinghouse publishes: this engine signs each payment there itself, with the key the
# clearinghouse handed over for the actor. On one host it is the clearinghouse project's signer-relay,
# on the same edge network.
LPB_SIGNER_URL=http://signer:8937

# ---- this engine's own secret key (python3 -c or `lpb gen-secret-key`; see README.md) -------------
# The engine stores each handed key under it.
LPB_SECRET_KEY=replace-with-a-new-secret-key

# ---- the one published port, on 127.0.0.1 ----------------------------------------------------------
ENTERPRISE_PORT=8280

# Copy to .env (git-ignored, mode 0600). The engine discovers through the signer.
LPB_ALLOCATION_MODE=per_actor
LPB_SIGNER_URL=http://clearinghouse:8937          # the signer shares the clearinghouse network namespace
LPB_BATTERIES_URL=http://clearinghouse:8081
LPB_BATTERIES_TOKEN=                               # contents of secrets/engine-token
LPB_GRANT_ID=                                      # from the grant create step in README.md
LPB_SECRET_KEY=                                    # uv run lpb gen-secret-key
LPB_DEFAULT_CURRENCY=USD

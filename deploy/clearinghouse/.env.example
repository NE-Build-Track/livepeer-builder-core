# Copy to .env (git-ignored, mode 0600), or let config/init-secrets.py write it: it fills the two
# values it generates. Compose reads .env for the variables below; the engine's own settings are in
# compose.yaml. Never commit the populated file.

# Registry prefix for the images this project builds; empty keeps local-only names. Nothing is pushed.
IMAGE_REGISTRY=

# ---- the wallet the signer signs with ------------------------------------------------------------
# The folder that holds the encrypted key file and its password file, wherever it is kept. It is
# mounted read-only into the signer and nothing is copied. An absolute path.
WALLET_KEY_DIR=/path/to/the/wallet/key/folder
# The names of the two files in that folder. A newline at the end of the password file is left out.
WALLET_KEYSTORE_FILE=name-of-the-key-file
WALLET_PASSWORD_FILE=name-of-the-password-file
# The wallet's public address, for Batteries' on-chain listener (the deposit and reserve it reports).
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# ---- the engine's credentials (config/init-secrets.py fills these) ---------------------------------
LPB_BATTERIES_TOKEN=replace-with-secrets/engine-token
LPB_BATTERIES_GRANTS_TOKEN=replace-with-secrets/grant-desk-token
# No LPB_SECRET_KEY: a clearinghouse hands each allocation's key to the caller and stores none.

# ---- the two published ports, on 127.0.0.1 ---------------------------------------------------------
# The engine's public listener: what a tenant's admin and its engine call.
CLEARINGHOUSE_PUBLIC_PORT=8180
# The signer: where a tenant's engine signs, with the key it was handed.
CLEARINGHOUSE_SIGNER_PORT=8137
